APP_NAME=Lamsa API
APP_ENV=development
DEBUG=true
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lamsa
DB_USER=lamsa
DB_PASSWORD=change_me
STORAGE_BACKEND=local
MEDIA_ROOT=./media
MEDIA_URL=http://127.0.0.1:8000/media
MAX_UPLOAD_MB=5
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=60
REFRESH_REUSE_GRACE_SECONDS=20
SIGNUP_TOKEN_MINUTES=10
GOOGLE_CLIENT_IDS=
GOOGLE_DEV_MODE=false
DEFAULT_PHONE_REGION=SY
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Our proxies (Nginx, website server) whose X-Forwarded-For is trusted; empty = nobody.
# Local development with lamsa-web: 127.0.0.1,::1. Start the API with --no-proxy-headers.
TRUSTED_PROXY_IPS=
# Deprecated (removed next release); use TRUSTED_PROXY_IPS.
TRUST_PROXY_HEADERS=false
TEST_DATABASE_NAME=lamsa_test
# Push notifications: log (development, no Firebase) | firebase (needs the service account JSON in secrets/)
PUSH_BACKEND=log
# FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json
# Run the background worker inside the API process (default: true only when APP_ENV=development)
# RUN_WORKER_IN_APP=false
# Cache (Valkey): docker compose up -d valkey. Optional at runtime.
CACHE_ENABLED=true
CACHE_URL=redis://127.0.0.1:6379/0
CACHE_KEY_PREFIX=lamsa:
CACHE_TIMEOUT_MS=1000
# Load protection (see README, Production tuning). Default hash concurrency: number of cores.
# PASSWORD_HASH_CONCURRENCY=4
PASSWORD_HASH_QUEUE_TIMEOUT=5
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=3600
SLOW_QUERY_MS=200
SLOW_REQUEST_MS=1000
