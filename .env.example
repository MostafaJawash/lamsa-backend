APP_NAME=Lamsa API
APP_ENV=development
DEBUG=true
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lamsa
DB_USER=lamsa
DB_PASSWORD=change_me
STORAGE_BACKEND=local
MEDIA_ROOT=./media
MEDIA_URL=http://127.0.0.1:8000/media
MAX_UPLOAD_MB=5
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=60
REFRESH_REUSE_GRACE_SECONDS=20
SIGNUP_TOKEN_MINUTES=10
GOOGLE_CLIENT_IDS=
GOOGLE_DEV_MODE=false
DEFAULT_PHONE_REGION=DE
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HEADERS=false
TEST_DATABASE_NAME=lamsa_test
# Push notifications: log (development, no Firebase) | firebase (needs the service account JSON in secrets/)
PUSH_BACKEND=log
# FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json
# Run the background worker inside the API process (default: true only when APP_ENV=development)
# RUN_WORKER_IN_APP=false
