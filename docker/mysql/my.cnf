# MySQL 8.4/9.x settings for a small VPS running the API, the worker and MySQL together.
# An EXAMPLE only: nothing applies this file. Review before use (see README, "Production tuning").
#
# Sized for 4 CPU cores / 8 GB RAM. Connection budget (see README):
#   4 API workers x (DB_POOL_SIZE 10 + DB_MAX_OVERFLOW 10) = 80
#   + worker process 20 + admin/backup/migrations 20 = 120 -> max_connections 150

[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci
default-time-zone    = '+00:00'

max_connections          = 150
wait_timeout             = 600
interactive_timeout      = 600

# InnoDB: give it most of the RAM MySQL may use (about 50-60 % of the machine here).
innodb_buffer_pool_size      = 4G
innodb_buffer_pool_instances = 4
innodb_redo_log_capacity     = 1G
innodb_flush_log_at_trx_commit = 1   # durability for orders; do not lower
innodb_flush_method          = O_DIRECT
innodb_io_capacity           = 1000  # SSD

# Slow query log: anything slower than 200 ms (matches SLOW_QUERY_MS in the API).
slow_query_log      = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time     = 0.2
log_queries_not_using_indexes = 0

# Product search uses a FULLTEXT index with the ngram parser: keep the default token size
# (changing it requires rebuilding that index).
ngram_token_size = 2
